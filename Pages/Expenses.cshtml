
@page
@model MeineErsteWebApp.Pages.ExpensesModel

@{
    ViewData["Title"] = "Persönliches Ausgaben-Tagebuch";
}

<div class="container py-4">
    <h1 class="mb-3">Persönliches Ausgaben-Tagebuch</h1>

    @if (Model.IsEditing)
    {
        <h2 class="mt-4">Ausgabe bearbeiten</h2>

        <form method="post" asp-page-handler="Update">
            <input type="hidden" asp-for="EditExpense.Id" />

            <div class="mb-3">
                <label asp-for="EditExpense.Amount" class="form-label">Betrag (€)</label>
                <input asp-for="EditExpense.Amount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="EditExpense.Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EditExpense.Description" class="form-label">Beschreibung</label>
                <input asp-for="EditExpense.Description" class="form-control" />
                <span asp-validation-for="EditExpense.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EditExpense.CategoryId" class="form-label">Kategorie</label>
                <select asp-for="EditExpense.CategoryId" class="form-select">
                    <option value="">Bitte auswählen</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="EditExpense.CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EditExpense.Date" class="form-label">Datum</label>
                <input asp-for="EditExpense.Date" class="form-control" type="date" />
                <span asp-validation-for="EditExpense.Date" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EditExpense.PaymentMethod" class="form-label">Zahlungsmethode</label>
                <select asp-for="EditExpense.PaymentMethod" class="form-select">
                    <option value="Bar">Bar</option>
                    <option value="Karte">Karte</option>
                    <option value="Überweisung">Überweisung</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="EditExpense.Note" class="form-label">Notiz (optional)</label>
                <textarea asp-for="EditExpense.Note" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Änderungen speichern</button>
            <a asp-page="/Expenses" class="btn btn-secondary">Abbrechen</a>
        </form>
    }
    else
    {
        <h2 class="mt-4">Neue Ausgabe erfassen</h2>

        <form method="post">
            <div class="mb-3">
                <label asp-for="NewExpense.Amount" class="form-label">Betrag (€)</label>
                <input asp-for="NewExpense.Amount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="NewExpense.Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewExpense.Description" class="form-label">Beschreibung</label>
                <input asp-for="NewExpense.Description" class="form-control" />
                <span asp-validation-for="NewExpense.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewExpense.CategoryId" class="form-label">Kategorie</label>
                <select asp-for="NewExpense.CategoryId" class="form-select">
                    <option value="">Bitte auswählen</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="NewExpense.CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewExpense.Date" class="form-label">Datum</label>
                <input asp-for="NewExpense.Date" class="form-control" type="date" />
            </div>

            <div class="mb-3">
                <label asp-for="NewExpense.PaymentMethod" class="form-label">Zahlungsmethode</label>
                <select asp-for="NewExpense.PaymentMethod" class="form-select">
                    <option value="Bar">Bar</option>
                    <option value="Karte">Karte</option>
                    <option value="Überweisung">Überweisung</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="NewExpense.Note" class="form-label">Notiz (optional)</label>
                <textarea asp-for="NewExpense.Note" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Ausgabe speichern</button>
        </form>
    }

    <h2 class="mt-4">Meine Ausgaben</h2>

    @if (Model.Expenses.Count == 0)
    {
        <p>Noch keine Ausgaben gespeichert.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Datum</th>
                        <th scope="col">Beschreibung</th>
                        <th scope="col">Betrag</th>
                        <th scope="col">Zahlungsmethode</th>
                        <th scope="col">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.Expenses)
                    {
                        <tr>
                            <td>@expense.Date.ToString("dd.MM.yyyy")</td>
                            <td>@expense.Description</td>
                            <td>@expense.Amount.ToString("F2") €</td>
                            <td>@expense.PaymentMethod</td>
                            <td>
                                <a asp-page-handler="Edit"
                                   asp-route-id="@expense.Id"
                                   class="btn btn-warning btn-sm me-1">
                                    Bearbeiten
                                </a>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@expense.Id"
                                      onsubmit="return confirm('Möchtest du diese Ausgabe wirklich löschen?');"
                                      style="display: inline;">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Löschen
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="mt-4">Meine Kategorien</h2>

    <ul class="list-unstyled">
        @foreach (var category in Model.Categories)
        {
            <li class="mb-2">
                <span style="color: @category.Color">●</span>
                @category.Name
            </li>
        }
    </ul>
</div>
